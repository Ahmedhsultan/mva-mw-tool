rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reservations — any authenticated user (including anonymous)
    match /reservations/{docId} {
      allow read, write: if request.auth != null;
    }

    // Pipeline run history — any authenticated user (including anonymous)
    match /pipeline-runs/{docId} {
      allow read, write: if request.auth != null;

      // Viewers presence subcollection
      match /viewers/{viewerId} {
        allow read, write: if request.auth != null;
      }
    }

    // Shared app settings — any authenticated user
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // Per-user settings (PAT, sprint team) — only owner can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
