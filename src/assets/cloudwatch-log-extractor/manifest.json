{
  "manifest_version": 3,
  "name": "VOIS Curl Extractor",
  "version": "1.0",
  "description": "Extract VOIS curl from aws logs",
  "author": "Sultan",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://eu-west-1.console.aws.amazon.com/cloudwatch/home*"
  ],
  "content_scripts": [
    {
      "matches": ["https://eu-west-1.console.aws.amazon.com/cloudwatch/home*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
