{
  "manifest_version": 3,
  "name": "MVAX Log to cURL",
  "version": "2.0.0",
  "description": "Floating button on CloudWatch pages — reads MVAX_AUDIT log from clipboard and generates a cURL command.",
  "author": "Sultan",
  "permissions": ["clipboardRead", "clipboardWrite"],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.console.aws.amazon.com/cloudwatch/*"],
      "js": ["curl-printer.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}



